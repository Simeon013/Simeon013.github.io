---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import logo from '../assets/brand/logo.png';
import { locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Chemin de la page courante dans chaque langue, pour que FR/EN mène à la même page. */
  paths?: Record<Locale, string>;
}

const { locale, paths } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '');
// Liens vers les sections de l'accueil : ils fonctionnent aussi depuis une étude de cas.
const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#journey`, label: t('nav.journey') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
const langs = locales.map((l) => ({ code: l, href: getRelativeLocaleUrl(l, paths?.[l] ?? ''), current: l === locale }));
---

<header class="nav wrap">
  <a class="nav__logo" href={home} aria-label="Siméon Daouda">
    <Image src={logo} alt="" width={120} height={120} loading="eager" />
  </a>
  <nav aria-label={t('nav.sections')}>
    <ul class="nav__links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <ul class="nav__langs" aria-label={t('nav.language')}>
    {
      langs.map((l) => (
        <li>
          <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? 'true' : undefined}>
            {l.code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <span data-menu-label data-open={t('nav.menu')} data-close={t('nav.close')}>&lt;{t('nav.menu')} /&gt;</span>
  </button>
</header>

<div class="menu" id="mobile-menu" hidden data-menu>
  <nav aria-label={t('nav.sections')}>
    <ul class="menu__links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="glitchable" data-menu-link data-text={l.label}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ul class="menu__langs" aria-label={t('nav.language')}>
    {
      langs.map((l) => (
        <li>
          <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? 'true' : undefined}>
            {l.code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="menu__signal">{t('hero.location')} — {t('hero.coords')}</p>
</div>

<script>
  import { scrambleTo } from '../scripts/effects';

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && menu && label) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = `<${open ? label.dataset.close : label.dataset.open} />`;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        const links = menu.querySelectorAll<HTMLElement>('[data-menu-link]');
        links.forEach((link, i) => {
          const text = link.dataset.text ?? '';
          link.classList.add('is-glitching');
          setTimeout(() => scrambleTo(link, text, 450).then(() => link.classList.remove('is-glitching')), i * 70);
        });
        links[0]?.focus();
      }
    };
    toggle.addEventListener('click', () => setOpen(Boolean(menu.hidden)));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 14px;
    font-size: 13px;
  }
  .nav__logo {
    display: block;
    width: 56px;
    height: 56px;
    margin: -8px;
  }
  .nav__links,
  .nav__langs,
  .menu__links,
  .menu__langs {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links {
    gap: 30px;
  }
  .nav__links a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav__links a:hover {
    color: var(--green);
  }
  .nav__langs a,
  .menu__langs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
    color: var(--faint);
  }
  .nav__langs a[aria-current],
  .menu__langs a[aria-current] {
    color: var(--green);
  }
  .nav__toggle {
    display: none;
    min-height: 44px;
    padding: 0 14px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--green);
    font: 500 13px/1 var(--font-body);
    cursor: pointer;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: var(--black);
    padding: 96px var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    animation: menu-in 0.3s steps(4) both;
  }
  .menu[hidden] {
    display: none;
  }
  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .menu__links {
    flex-direction: column;
    gap: 4px;
  }
  .menu__links a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(32px, 9vw, 44px);
    line-height: 1.3;
    color: var(--white);
    text-decoration: none;
  }
  .menu__links a:hover,
  .menu__links a:focus-visible {
    color: var(--green);
  }
  .menu__langs {
    gap: 8px;
  }
  .menu__signal {
    margin-top: auto;
    font-size: 12px;
    color: var(--faint);
  }

  @media (max-width: 820px) {
    .nav__links,
    .nav__langs {
      display: none;
    }
    .nav__toggle {
      display: inline-flex;
      align-items: center;
    }
  }
  @media (min-width: 821px) {
    .menu {
      display: none;
    }
  }
</style>
