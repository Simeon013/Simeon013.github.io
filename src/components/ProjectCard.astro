---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const { visual } = project;
---

<article class="card" data-reveal data-flicker>
  <div class="card__visual">
    {
      visual.kind === 'image' && (
        <div class:list={['card__shots', { 'card__shots--pair': visual.images.length > 1 }]}>
          {visual.images.map((img) => (
            <Image src={img.src} alt={img.alt[locale]} widths={[480, 800, 1200]} sizes="(max-width: 820px) 92vw, 620px" />
          ))}
        </div>
      )
    }
    {
      visual.kind === 'mock' && visual.mock === 'order' && (
        <div class="mock" role="img" aria-label={t('work.illustration')}>
          <div class="mock__phone">
            <span class="mock__label">table 07</span>
            <span class="mock__qr"><span class="mock__beam" /></span>
            <span class="mock__line" />
            <span class="mock__line" />
            <span class="mock__line mock__line--short" />
            <span class="mock__button mock__button--ghost" />
            <span class="mock__button" />
          </div>
        </div>
      )
    }
    {
      visual.kind === 'mock' && visual.mock === 'insurance' && (
        <div class="mock" role="img" aria-label={t('work.illustration')}>
          <div class="mock__phone">
            <span class="mock__label">{locale === 'fr' ? 'contrats' : 'contracts'}</span>
            <span class="mock__row"><span /><i /></span>
            <span class="mock__row"><span /><i class="is-late" /></span>
            <span class="mock__row"><span /><i /></span>
            <span class="mock__row"><span /><i class="is-late" /></span>
            <span class="mock__button" />
          </div>
        </div>
      )
    }
  </div>
  <p class="card__category">
    {project.category[locale]}
    {visual.kind === 'mock' && <span class="card__note">· {t('work.illustration')}</span>}
  </p>
  <h3 class="card__name">{project.name}</h3>
  <p class="card__summary">{project.summary[locale]}</p>
  <div class="card__foot">
    <ul class="card__stack">{project.stack.map((s) => <li>{s}</li>)}</ul>
    {
      project.links && (
        <ul class="card__links">
          {project.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card__visual {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    margin-bottom: 8px;
  }
  .card__shots {
    height: 100%;
  }
  .card__shots :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: filter 0.2s;
  }
  .card__shots--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
  }

  /* Au survol, le visuel décroche : deux bandes décalées, vert et violet. */
  .card__visual::before,
  .card__visual::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    opacity: 0;
  }
  /* Deux fines lignes de parasite… */
  .card.is-glitching .card__visual::before,
  .card:hover .card__visual::before {
    opacity: 0.8;
    top: 34%;
    height: 2px;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: shift 0.6s steps(2) infinite;
  }
  .card.is-glitching .card__visual::after,
  .card:hover .card__visual::after {
    opacity: 0.8;
    top: 68%;
    height: 2px;
    background: var(--violet);
    box-shadow: 0 0 8px var(--violet);
    animation: shift 0.45s steps(2) infinite reverse;
  }
  /* …et le visuel lui-même qui se découpe en tranches décalées. */
  .card.is-glitching .card__visual > *,
  .card:hover .card__visual > * {
    animation: slice-jump 0.36s steps(1) 1;
  }
  @keyframes slice-jump {
    0% {
      clip-path: inset(8% 0 58% 0);
      transform: translateX(-10px);
      filter: hue-rotate(90deg) saturate(2);
    }
    25% {
      clip-path: inset(48% 0 18% 0);
      transform: translateX(8px);
    }
    50% {
      clip-path: inset(0 0 76% 0);
      transform: translateX(-4px);
      filter: none;
    }
    75% {
      clip-path: inset(70% 0 0 0);
      transform: translateX(5px);
    }
    100% {
      clip-path: inset(0);
      transform: none;
    }
  }
  @keyframes shift {
    0% {
      transform: translateX(-4%);
    }
    100% {
      transform: translateX(5%);
    }
  }

  .card__note {
    color: var(--faint);
    margin-left: 6px;
  }
  .card__category {
    font-size: 12px;
    color: var(--green);
  }
  .card__name {
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
  }
  .card__summary {
    font-size: 14px;
    max-width: 52ch;
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 16px;
  }
  .card__stack,
  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12px;
  }
  .card__stack {
    color: var(--muted);
  }
  .card__links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .mock {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mock__phone {
    width: 30%;
    max-width: 140px;
    aspect-ratio: 9 / 17;
    border: 1px solid var(--green);
    border-radius: 16px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--black);
  }
  .mock__label {
    font-size: 10px;
    color: var(--faint);
  }
  .mock__line {
    height: 9px;
    background: var(--line);
  }
  .mock__line--short {
    width: 60%;
  }
  .mock__line {
    transform-origin: left;
    animation: type-line 3.6s steps(6) infinite;
  }
  .mock__line:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .mock__line:nth-of-type(4) {
    animation-delay: 0.8s;
  }
  @keyframes type-line {
    0% {
      transform: scaleX(0);
    }
    40%,
    100% {
      transform: scaleX(1);
    }
  }
  .mock__qr {
    position: relative;
    align-self: center;
    /* aspect-ratio seul donnait une hauteur nulle dans la colonne flex :
       le padding en pourcentage garantit un carré. */
    width: 46%;
    height: 0;
    padding-bottom: 46%;
    flex-shrink: 0;
    background-image:
      repeating-linear-gradient(0deg, #000 0 3px, transparent 3px 7px),
      repeating-linear-gradient(90deg, var(--green) 0 5px, transparent 5px 8px);
    opacity: 0.8;
    outline: 3px solid var(--green);
    outline-offset: 2px;
  }
  .mock__beam {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 0;
    height: 100%;
    border-top: 2px solid var(--violet);
    animation: beam 1.8s ease-in-out infinite;
  }
  @keyframes beam {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(100%);
    }
  }
  .mock__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }
  .mock__row span {
    height: 7px;
    flex: 1;
    background: var(--line);
  }
  .mock__row i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }
  .mock__row i.is-late {
    background: var(--violet);
    animation: late 1s steps(1) infinite;
  }
  @keyframes late {
    50% {
      opacity: 0.15;
    }
  }
  .mock__button {
    margin-top: auto;
    height: 18px;
    background: var(--green);
  }
  .mock__button--ghost {
    background: transparent;
    border: 1px solid var(--green);
  }
  .mock__button--ghost + .mock__button {
    margin-top: 0;
  }
</style>
