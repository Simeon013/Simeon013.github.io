---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { caseStudies, caseStudyPath, type CaseStudy, type Shot } from '../data/case-studies';
import { contact } from '../data/projects';
import { locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  study: CaseStudy;
  locale: Locale;
}

const { study, locale } = Astro.props;
const t = useTranslations(locale);
const paths = Object.fromEntries(locales.map((l) => [l, caseStudyPath[l](study.slug)])) as Record<Locale, string>;
const home = getRelativeLocaleUrl(locale, '');
const index = caseStudies.findIndex((c) => c.slug === study.slug);
const next = caseStudies[(index + 1) % caseStudies.length];
const nextHref = getRelativeLocaleUrl(locale, caseStudyPath[locale](next.slug));
const phones = study.built.shots.filter((s: Shot) => s.kind === 'phone');
const wides = study.built.shots.filter((s: Shot) => s.kind === 'wide');
---

<Base locale={locale} title={`${study.name} — Siméon Daouda`} description={study.tagline[locale]} paths={paths}>
  <Nav locale={locale} paths={paths} />

  <main class="case wrap">
    <a class="case__back" href={`${home}#work`}>&lt; {t('case.back')}</a>

    <header class="case__head">
      <p class="case__category">{study.category[locale]}</p>
      <h1 class="case__title glitchable" data-scramble>{study.name}</h1>
      <p class="case__tagline">{study.tagline[locale]}</p>
      <dl class="case__meta">
        {
          study.meta.map((m) => (
            <div>
              <dt>{m.label[locale]}</dt>
              <dd>{m.value[locale]}</dd>
            </div>
          ))
        }
      </dl>
      {
        study.link && (
          <a class="button" href={study.link.url} target="_blank" rel="noopener">
            {study.link.label}
          </a>
        )
      }
    </header>

    <figure class="shot shot--hero" data-reveal>
      <div class="shot__frame">
        <Image src={study.hero.src} alt={study.hero.alt[locale]} widths={[640, 1024, 1440, 2000]} sizes="(max-width: 1280px) 94vw, 1280px" loading="eager" />
      </div>
      <figcaption>{study.hero.caption[locale]}</figcaption>
    </figure>

    <section class="block" aria-labelledby="problem-title">
      <h2 id="problem-title" class="block__title glitchable" data-scramble>{t('case.problem')}</h2>
      <div class="block__body">
        {study.problem.map((p) => <p data-reveal>{p[locale]}</p>)}
      </div>
    </section>

    <section class="block" aria-labelledby="built-title">
      <h2 id="built-title" class="block__title glitchable" data-scramble>{t('case.built')}</h2>
      <div class="block__body">
        <p data-reveal>{study.built.intro[locale]}</p>
      </div>
    </section>

    {
      study.built.shots.length > 0 && (
        <div class="gallery">
          {phones.length > 0 && (
            <div class="gallery__phones">
              {phones.map((s) => (
                <figure class="shot shot--phone" data-reveal>
                  <div class="shot__frame">
                    <Image src={s.src} alt={s.alt[locale]} widths={[320, 480, 780]} sizes="(max-width: 820px) 44vw, 300px" />
                  </div>
                  <figcaption>{s.caption[locale]}</figcaption>
                </figure>
              ))}
            </div>
          )}
          {wides.map((s) => (
            <figure class="shot shot--wide" data-reveal>
              <div class="shot__frame">
                <Image src={s.src} alt={s.alt[locale]} widths={[640, 1024, 1640]} sizes="(max-width: 820px) 94vw, 720px" />
              </div>
              <figcaption>{s.caption[locale]}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <section class="block" aria-labelledby="role-title">
      <h2 id="role-title" class="block__title glitchable" data-scramble>{t('case.role')}</h2>
      <div class="block__body">
        {study.role.map((p) => <p data-reveal>{p[locale]}</p>)}
      </div>
    </section>

    <section class="block block--wide" aria-labelledby="choices-title">
      <h2 id="choices-title" class="block__title glitchable" data-scramble>{t('case.choices')}</h2>
      <ul class="choices">
        {
          study.choices.map((c) => (
            <li class="choice" data-reveal>
              <h3 class="choice__title">{c.title[locale]}</h3>
              <p>{c.text[locale]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      study.status && (
        <section class="block" aria-labelledby="status-title">
          <h2 id="status-title" class="block__title glitchable" data-scramble>{t('case.status')}</h2>
          <div class="block__body">
            <p class="case__status" data-reveal>
              <span class="case__dot" aria-hidden="true" />
              {study.status[locale]}
            </p>
          </div>
        </section>
      )
    }

    <nav class="case__foot" aria-label={t('case.next')}>
      <a class="next" href={nextHref}>
        <span class="next__label">{t('case.next')}</span>
        <span class="next__name">{next.name}</span>
        <span class="next__tagline">{next.tagline[locale]}</span>
      </a>
      <div class="cta">
        <p class="cta__title">{t('case.ctaTitle')}</p>
        <p class="cta__text">{t('case.ctaText')}</p>
        <div class="cta__actions">
          <a class="button button--solid" href={contact.whatsapp} target="_blank" rel="noopener">{t('contact.whatsapp')}</a>
          <a class="button" href={`${home}#contact`}>{t('nav.contact')}</a>
        </div>
      </div>
    </nav>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  .case {
    padding-bottom: clamp(64px, 8vw, 104px);
  }
  .case__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .case__back:hover {
    color: var(--green);
  }

  .case__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block: clamp(24px, 4vw, 48px) clamp(32px, 5vw, 56px);
  }
  .case__category {
    font-size: 13px;
    color: var(--green);
  }
  .case__title {
    font-size: clamp(44px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .case__tagline {
    max-width: 44ch;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
    font-weight: 300;
  }
  .case__meta {
    margin: 12px 0 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    width: 100%;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .case__meta div {
    background: var(--black);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .case__meta dt {
    font-size: 11px;
    color: var(--faint);
  }
  .case__meta dd {
    margin: 0;
    font-size: 14px;
    color: var(--white);
  }

  /* Captures : cadre fin, qui décroche en tranches au survol comme les cartes projet. */
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .shot__frame {
    position: relative;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .shot__frame :global(img) {
    width: 100%;
  }
  .shot:hover .shot__frame :global(img) {
    animation: slice-jump 0.36s steps(1) 1;
  }
  @keyframes slice-jump {
    0% {
      clip-path: inset(10% 0 56% 0);
      transform: translateX(-10px);
      filter: hue-rotate(90deg) saturate(2);
    }
    33% {
      clip-path: inset(50% 0 18% 0);
      transform: translateX(8px);
    }
    66% {
      clip-path: inset(0 0 78% 0);
      transform: translateX(-4px);
      filter: none;
    }
    100% {
      clip-path: inset(0);
      transform: none;
    }
  }
  .shot figcaption {
    font-size: 12px;
    color: var(--muted);
    max-width: 60ch;
  }
  .shot--hero {
    margin-bottom: clamp(56px, 8vw, 104px);
  }
  .shot--phone .shot__frame {
    border-radius: 22px;
    border-color: rgba(30, 242, 160, 0.35);
    padding: 8px;
  }
  .shot--phone .shot__frame :global(img) {
    border-radius: 14px;
  }

  /* Blocs de texte : titre à gauche, texte à droite, comme un sommaire qu'on lit en diagonale. */
  .block {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(16px, 4vw, 64px);
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }
  .block__title {
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    align-self: start;
  }
  .block__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 62ch;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.8;
  }
  .block--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    padding-block: 8px clamp(48px, 6vw, 80px);
  }
  .gallery__phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .choices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .choice {
    background: var(--black);
    padding: clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.7;
  }
  .choice__title {
    font-size: 18px;
    line-height: 1.25;
    color: var(--green);
  }

  .case__status {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--white);
  }
  .case__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    animation: blink 1.4s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  .case__foot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(32px, 5vw, 56px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .next,
  .cta {
    background: var(--black);
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .next {
    text-decoration: none;
    color: var(--text);
    transition: background-color 0.15s;
  }
  .next:hover {
    background: var(--surface);
  }
  .next__label {
    font-size: 12px;
    color: var(--faint);
  }
  .next__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1;
    color: var(--white);
  }
  .next:hover .next__name {
    color: var(--green);
  }
  .next__tagline {
    font-size: 14px;
    max-width: 40ch;
  }
  .cta__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 2.4vw, 30px);
    color: var(--white);
  }
  .cta__text {
    font-size: 14px;
    color: var(--muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 820px) {
    .block,
    .gallery,
    .case__foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .choices {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
