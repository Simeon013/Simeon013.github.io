  } catch (e) { $("vic-partager").textContent = "Copie impossible"; }
  setTimeout(() => { $("vic-partager").textContent = "Partager"; }, 2000);
};
$("vic-calendrier").onclick = () => { $("f-victoire").hidden = true; montrer("calendrier"); };

// ---------- la petite démonstration de l'accueil ----------
(function demo() {
  const c = $("demo"), g = c.getContext("2d");
  const parcours = [[0, 0], [1, 0], [2, 0], [2, 1], [1, 1], [0, 1], [0, 2], [1, 2], [2, 2]];
  const p = 100, o = 0;
  let t0 = performance.now();
  function image(t) {
    const pas = 100, k = Math.max(1, Math.min(parcours.length, Math.floor((t - t0) / 420) + 1));
    g.clearRect(0, 0, 300, 300);
    for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) { g.fillStyle = "#16303a"; rr(g, i * pas + 6, j * pas + 6, pas - 12, pas - 12, 16); g.fill(); }
    const cx = (q) => [q[0] * pas + 50, q[1] * pas + 50];
    g.strokeStyle = "#3fbf86"; g.lineWidth = 12; g.lineCap = g.lineJoin = "round"; g.beginPath();
    parcours.slice(0, k).forEach((q, i) => { const [x, y] = cx(q); i ? g.lineTo(x, y) : g.moveTo(x, y); }); g.stroke();
    parcours.forEach((q, i) => {
      const [x, y] = cx(q);
      if (i === 0) eclair(g, x, y, 28);
      else if (i === parcours.length - 1) { if (k === parcours.length) halo(g, x, y, 70, "#ffce5c", "aa"); etoile(g, x, y, 32, k === parcours.length ? "#ffe08a" : "#b8923f"); }
      else if (i === 2) boule(g, x, y, 26, "tourne", i < k);
      else if (i === 4) boule(g, x, y, 26, "droit", i < k);
      else { if (i < k) halo(g, x, y, 46, COULEURS[i % 6], "55"); ampoule(g, x, y, 24, COULEURS[i % 6], i < k, 0.2); }
    });
    const [fx, fy] = cx(parcours[k - 1]);
    if (k < parcours.length) { g.fillStyle = "rgba(220,170,140,.9)"; g.beginPath(); g.arc(fx + 14, fy + 18, 18, 0, 7); g.fill(); }
    if (t - t0 > parcours.length * 420 + 1600) t0 = t;
    if (!document.hidden) requestAnimationFrame(image); else setTimeout(() => requestAnimationFrame(image), 500);
  }
  requestAnimationFrame(image);
})();


// ---------- le son : une petite musique de Noël composée pour le jeu, et des effets, tout synthétisé ----------
let audio = null, sortieMusique, sortieEffets;
let reglageSon = (() => { try { return localStorage.getItem("avent-son") || "tout"; } catch (e) { return "tout"; } })();   // tout, effets, muet
function audioPret() {
  if (!audio) {
    try {
      audio = new (window.AudioContext || window.webkitAudioContext)();
      const maitre = audio.createGain(); maitre.gain.value = 0.9;
      const compresseur = audio.createDynamicsCompressor(); compresseur.connect(audio.destination); maitre.connect(compresseur);
      sortieMusique = audio.createGain(); sortieMusique.connect(maitre);
      sortieEffets = audio.createGain(); sortieEffets.connect(maitre);
      appliquerSon();
    } catch (e) { return false; }
  }
  if (audio.state === "suspended") audio.resume();
  return true;
}
function appliquerSon() {
  if (sortieMusique) sortieMusique.gain.value = reglageSon === "tout" ? 0.16 : 0;
  if (sortieEffets) sortieEffets.gain.value = reglageSon === "muet" ? 0 : 0.5;
  const textes = { tout: "Son", effets: "Effets", muet: "Muet" };
  document.querySelectorAll("[data-son-texte]").forEach((e) => e.textContent = textes[reglageSon]);
  document.querySelectorAll("[data-onde]").forEach((e) => e.style.opacity = reglageSon === "muet" ? 0 : (reglageSon === "effets" ? 0.4 : 1));
  document.querySelectorAll("[data-son]").forEach((e) => e.setAttribute("aria-label", `Son : ${textes[reglageSon]} (toucher pour changer)`));
}
document.querySelectorAll("[data-son]").forEach((b) => b.addEventListener("click", () => {
  reglageSon = { tout: "effets", effets: "muet", muet: "tout" }[reglageSon];
  try { localStorage.setItem("avent-son", reglageSon); } catch (e) {}
  audioPret(); appliquerSon();
  if (reglageSon === "tout") musique.demarrer();
}));
// le premier toucher, n'importe où, réveille le son (les navigateurs l'exigent)
window.addEventListener("pointerdown", () => { if (audioPret() && !$("ecran-jeu").hidden) musique.demarrer(); }, { once: true });

function cloche(f, t, duree, volume, sortie) {
  // une cloche douce, façon célesta : une fondamentale et une harmonique qui s'éteignent vite
  for (const [mult, v] of [[1, 1], [2.76, 0.28], [5.4, 0.08]]) {
    const o = audio.createOscillator(), g = audio.createGain();
    o.type = "sine"; o.frequency.value = f * mult;
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(volume * v, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, t + duree / mult);
    o.connect(g); g.connect(sortie); o.start(t); o.stop(t + duree + 0.05);
  }
}
function note(f, t, duree, volume, sortie, type) {
  const o = audio.createOscillator(), g = audio.createGain(), filtre = audio.createBiquadFilter();
  o.type = type || "triangle"; o.frequency.value = f; filtre.type = "lowpass"; filtre.frequency.value = 1800;
  g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(volume, t + 0.04); g.gain.exponentialRampToValueAtTime(0.0001, t + duree);
  o.connect(filtre); filtre.connect(g); g.connect(sortie); o.start(t); o.stop(t + duree + 0.05);
}
const hz = (midi) => 440 * Math.pow(2, (midi - 69) / 12);
const GAMME = [0, 2, 4, 7, 9];          // pentatonique : tout sonne juste ensemble

const son = {
  pas(avancee, surBoule) {               // chaque ampoule allumée monte d'un cran
    if (!audioPret() || reglageSon === "muet") return;
    const i = Math.floor(avancee * 15), m = 72 + 12 * Math.floor(i / 5) + GAMME[i % 5], t = audio.currentTime;
    cloche(hz(m), t, 0.6, 0.22, sortieEffets);
    if (surBoule) cloche(hz(m + 12), t + 0.05, 0.4, 0.12, sortieEffets);
  },
  retour() { if (!audioPret() || reglageSon === "muet") return; note(hz(60), audio.currentTime, 0.12, 0.12, sortieEffets, "sine"); },
  erreur() {
    if (!audioPret() || reglageSon === "muet") return;
    const t = audio.currentTime; note(hz(50), t, 0.12, 0.14, sortieEffets, "square"); note(hz(47), t + 0.1, 0.18, 0.14, sortieEffets, "square");
  },
  victoire() {
    if (!audioPret() || reglageSon === "muet") return;
    const t = audio.currentTime;
    [72, 76, 79, 84, 88, 91, 96].forEach((m, i) => cloche(hz(m), t + i * 0.08, 1.4, 0.2, sortieEffets));
    for (let k = 0; k < 14; k++) cloche(hz(96 + GAMME[k % 5] + 12 * (k % 2)), t + 0.7 + k * 0.05, 0.5, 0.05, sortieEffets);
  },
};

// la musique : 4 accords (do, la mineur, fa, sol), une basse douce et une mélodie de clochettes, en boucle
const musique = (() => {
  const accords = [[48, [60, 64, 67]], [45, [57, 60, 64]], [41, [53, 57, 60]], [43, [55, 59, 62]]];
  const melodie = [76, 79, 81, 79, 76, 74, 72, 74, 76, 72, 69, 72, 74, 76, 74, 72,
                   72, 76, 77, 76, 74, 72, 69, 72, 71, 74, 79, 77, 76, 74, 72, null];
  const temps = 60 / 96 / 2;            // une croche à 96 battements par minute
  let pas = 0, prochain = 0, minuteurMusique = null;
  function planifier() {
    while (prochain < audio.currentTime + 0.25) {
      const mesure = Math.floor(pas / 8) % 4, [basse, accord] = accords[mesure];
      if (pas % 8 === 0) { note(hz(basse), prochain, temps * 7.5, 0.5, sortieMusique, "sine"); accord.forEach((m) => note(hz(m), prochain, temps * 7.5, 0.1, sortieMusique, "triangle")); }
      const m = melodie[pas % melodie.length];
      if (m && pas % 2 === 0) cloche(hz(m), prochain, 0.9, 0.35, sortieMusique);
      prochain += temps; pas++;
    }
  }
  return {
    demarrer() {
      if (!audio || minuteurMusique) return;
      prochain = audio.currentTime + 0.1;
      minuteurMusique = setInterval(planifier, 100);
    },
  };
})();
appliquerSon();

montrer("accueil");
stat("visite", null, { nouveau: !memoire.vu, grille_du_jour: jourDuJour(), ecran: `${innerWidth}x${innerHeight}`,
  source: document.referrer ? new URL(document.referrer).hostname : "direct", records: Object.keys(memoire.records).length, flamme: flamme() });
if (!memoire.vu) { memoire.vu = new Date().toISOString().slice(0, 10); ecrire(memoire); }
