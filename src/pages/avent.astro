const LUTINS = [["Lutin Turbo", 1150], ["Lutin Pixel", 2300], ["Lutin Bug", 3800]];
const BONNET = '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" style="vertical-align:-1px;margin-right:4px"><path d="M2 13c2-6 5-10 11-9-2 2-3 5-3 9z" fill="#ff5a5f"/><rect x="1" y="12" width="10" height="3" rx="1.5" fill="#f2f2f2"/><circle cx="13.5" cy="4" r="1.8" fill="#f2f2f2"/></svg>';
const propre = (t) => String(t).replace(/[<>&"]/g, "");

async function afficherClassement() {
  const liste = $("classement");
  const lutins = LUTINS.map(([nom, parCase]) => ({ nom, t: cases.size * parCase, lutin: true }));
  let lignes, joueurs = 0, horsLigne = false;
  const moi = { nom: (memoire.nom || "Toi") + " (toi)", t: memoire.records[niv.jour], moi: true };
  if (niv.jour && !APERCU) {
    try {
      const d = await appel("avent_classement", { p_jour: niv.jour, p_appareil: appareil() });
      joueurs = d.length ? Number(d[0].joueurs) : 0;
      lignes = d.map((l) => ({ nom: l.nom + (l.moi ? " (toi)" : ""), t: l.temps_ms, moi: l.moi, rang: Number(l.rang) }));
      if (!lignes.some((l) => l.moi) && moi.t) lignes.push(Object.assign(moi, { rang: "–" }));   // pas encore envoyé (pas de pseudo…) : on se montre quand même
    } catch (e) { horsLigne = true; }
  }
  if (!lignes) lignes = [moi];
  // les lutins tiennent compagnie tant qu'il y a moins de 5 vrais joueurs sur la grille
  if (joueurs < 5) lignes = lignes.concat(lutins).sort((a, b) => a.t - b.t).map((l, i) => Object.assign(l, { rang: i + 1 }));
  liste.innerHTML = lignes.slice(0, 11).map((l) =>
    `<li class="${l.lutin ? "bot" : ""} ${l.moi ? "moi" : ""}"><span>${l.rang}</span><span>${l.lutin ? BONNET : ""}${propre(l.nom)}</span><span>${fmt(l.t)}</span></li>`).join("");
  $("note-classement").textContent = horsLigne ? "Classement indisponible pour le moment (pas de connexion ?) : ton temps est gardé sur ton téléphone."
    : !niv.jour ? "L'entraînement ne compte pas au classement. Les lutins sont les personnages du jeu : ils te donnent un temps à battre."
    : APERCU ? "Mode aperçu : les temps ne sont pas envoyés au classement."
    : (joueurs < 5 ? "Les lutins sont les personnages du jeu : ils te donnent un temps à battre." : `${joueurs} joueurs sur cette grille.`);
}

async function afficherGeneral() {
  const liste = $("classement-general");
  if (APERCU) { liste.innerHTML = '<li><span></span><span>Mode aperçu : pas de classement.</span><span></span></li>'; return; }
  try {
    const d = await appel("avent_classement_general", { p_appareil: appareil() });
    liste.innerHTML = d.length ? d.map((l) =>
      `<li class="${l.moi ? "moi" : ""}"><span>${l.rang}</span><span>${propre(l.nom)}${l.moi ? " (toi)" : ""}</span><span>${l.grilles} gr. · ${fmt(l.moyenne_ms)}</span></li>`).join("")
      : '<li><span></span><span>Personne encore : sois le premier !</span><span></span></li>';
  } catch (e) {
    liste.innerHTML = '<li><span></span><span>Classement indisponible pour le moment.</span><span></span></li>';
  }
}

$("f-nom").addEventListener("submit", async (e) => {
  e.preventDefault();
  const v = $("nom").value.trim().replace(/\s+/g, " ").slice(0, 16);
  if (!v) return;
  const bouton = $("f-nom").querySelector("button"); bouton.disabled = true;
  try {
    memoire.nom = await appel("avent_choisir_nom", { p_appareil: appareil(), p_nom: v });
  } catch (err) {
    bouton.disabled = false;
