document.querySelectorAll("[data-avis]").forEach((b) => b.addEventListener("click", ouvrirAvis));
document.querySelectorAll(".avent .note").forEach((b) => b.addEventListener("click", () => { noteAvis = Number(b.dataset.note); majNotes(); }));
