window.addEventListener("resize", () => { if (!$("ecran-jeu").hidden) redimensionner(); });

// ---------- victoire et classement de démonstration ----------
function gagner() {
  fini = performance.now(); celebration = fini; clearInterval(minuteur); majChrono();
  const t = tempsEcoule(), ancien = memoire.records[niv.jour];
  const nouveau = !ancien || t < ancien;
  if (nouveau) memoire.records[niv.jour] = Math.round(t);
  if (niv.jour && niv.jour === jourDuJour()) memoire.jourMeme[niv.jour] = true;      // la flamme : fini le jour même
  ecrire(memoire);
  vibrer([20, 40, 20]);
  son.victoire();
  stat("victoire", niv.jour, { temps: Math.round(t), indices: indicesPris, erreurs, retours, record: nouveau, jour_meme: niv.jour === jourDuJour(), flamme: flamme() });
  message("Toute la guirlande est allumée !");
  setTimeout(() => {
    $("vic-jour").textContent = niv.jour ? `Jour ${niv.jour} · ${niv.titre}` : "Entraînement";
    $("vic-temps").textContent = fmt(t);
    $("vic-indices").textContent = indicesPris ? `${indicesPris} indice${indicesPris > 1 ? "s" : ""} utilisé${indicesPris > 1 ? "s" : ""} (+${indicesPris * 5} s)` : "Sans indice !";
    $("vic-indices").classList.toggle("sans", !indicesPris);
    $("vic-detail").textContent = nouveau ? (ancien ? `Nouveau record ! (avant : ${fmt(ancien)})` : "Premier temps enregistré sur cet appareil.") : `Ton record reste ${fmt(ancien)}.`;
    $("nom").value = memoire.nom || "";
    $("f-nom").hidden = !!memoire.nom;
    envoyerTemps().then(afficherClassement);
    const suivant = NIVEAUX.find((n) => n.jour > niv.jour && n.jour > 0 && ouvert(n.jour));
    $("vic-suivant").hidden = !suivant;
    if (suivant) $("vic-suivant").onclick = () => { $("f-victoire").hidden = true; lancer(suivant.jour); };
    $("f-victoire").hidden = false;
    $("cal-flamme").textContent = $("jeu-flamme").textContent = flamme();
  }, 1100);
}

// ---------- le classement public (Supabase) : un pseudo, un temps, un identifiant d'appareil tiré au hasard ----------
const API = "https://ujithhyzbfuyabogulzs.supabase.co/rest/v1/rpc/";
const CLE = "sb_publishable_Xg-8uRQQs9ZqAFgcnnA-8Q_eGzMK9XP";     // clé publique : elle ne donne accès qu'aux deux fonctions du jeu
function appareil() {
  if (!memoire.appareil) {
    memoire.appareil = (crypto.randomUUID ? crypto.randomUUID() : "10000000-1000-4000-8000-100000000000".replace(/[018]/g, (c) => (c ^ (Math.random() * 16 >> c / 4)).toString(16)));
    ecrire(memoire);
  }
  return memoire.appareil;
}
async function appel(fonction, corps) {
  const r = await fetch(API + fonction, { method: "POST", headers: { apikey: CLE, "Content-Type": "application/json" }, body: JSON.stringify(corps) });
  const d = await r.json().catch(() => null);
  if (!r.ok) throw new Error((d && d.message) || "erreur");
  return d;
}
async function envoyerTemps() {
  if (!niv.jour || !memoire.nom || !memoire.records[niv.jour]) return;
  try {
    await appel("avent_envoyer", { p_jour: niv.jour, p_appareil: appareil(), p_nom: memoire.nom, p_temps_ms: memoire.records[niv.jour] });
  } catch (e) {
    if (e.message === "nom refusé" || e.message === "nom pris") {
      memoire.nom = ""; ecrire(memoire);
      $("f-nom").hidden = false; $("nom").value = "";
      $("nom").placeholder = e.message === "nom pris" ? "Ce pseudo est déjà pris : choisis-en un autre" : "Ce pseudo n'est pas accepté : choisis-en un autre";
    }
  }
}
// statistiques anonymes : un identifiant d'appareil tiré au hasard, le type d'événement, la grille, quelques chiffres
function stat(type, jour, donnees) {
  if (APERCU) return;                                // les essais de Siméon ne faussent pas les chiffres
  try {
    fetch(API + "avent_evenement", { method: "POST", keepalive: true, headers: { apikey: CLE, "Content-Type": "application/json" },
      body: JSON.stringify({ p_appareil: appareil(), p_type: type, p_jour: jour ?? null, p_donnees: donnees || {} }) }).catch(() => {});
  } catch (e) {}
}
function signalerAbandon() {
  // une partie commencée puis quittée sans être finie (retour, onglet fermé, autre grille)
  if (niv && debutSignale && !fini) {
    stat("abandon", niv.jour, { avancee: Math.round(100 * (chemin.length - 1) / (cases.size - 1)), temps: Math.round(tempsEcoule()), indices: indicesPris, erreurs });
    debutSignale = false;
  }
}
addEventListener("pagehide", signalerAbandon);
document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") signalerAbandon(); });

